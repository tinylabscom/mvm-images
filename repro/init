#!/bin/busybox sh
# switch_root probe harness: load virtio_blk (no-op for built-in kernels),
# mount the rootfs, write the probe, switch_root into it. No chroot.
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sys /sys
insmod /mods/virtio.ko
insmod /mods/virtio_ring.ko
insmod /mods/virtio_pci_modern_dev.ko
insmod /mods/virtio_pci_legacy_dev.ko
insmod /mods/virtio_pci.ko
insmod /mods/crc32c.ko 2>/dev/null || insmod /mods/crc32c_generic.ko
insmod /mods/virtio_blk.ko
insmod /mods/crc16.ko
insmod /mods/mbcache.ko
insmod /mods/jbd2.ko
insmod /mods/ext4.ko
sleep 1
mount -t devtmpfs devtmpfs /dev
mount -t ext4 -o rw /dev/vda /newroot
cat > /newroot/probe.sh <<'PROBE'
#!/bin/sh
mount -t proc proc /proc
echo AAA
unshare -Urmp sh -c 'for i in 1 2 3 4 5 6 7 8; do (true) 2>/dev/null || echo -n F; done; echo; echo STORM_DONE'
unshare -Urmp /usr/local/bin/k3s --version 2>&1 | head -2
echo BBB
poweroff -f
PROBE
chmod +x /newroot/probe.sh
echo ===SWITCH===
exec switch_root /newroot /bin/sh /probe.sh
